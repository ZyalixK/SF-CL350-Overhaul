          </And>
          <Not>
            <LowerEqual>
              <Simvar name="FUEL TANK LEFT MAIN QUANTITY" unit="gallon"/>
              <Constant>29.8</Constant>
            </LowerEqual>
          </Not>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Caution</Type>
      <Text>BATTERY FAULT</Text>
      <Condition>
        <Or>
          <Greater>
            <Simvar name="ELECTRICAL BATTERY BUS VOLTAGE" unit="volts"/>
