				<ANIM_NAME>DEICE_Knob_Wing_Source</ANIM_NAME>
				<VAR_NAME>L:P21_WING_SRC_KNOB</VAR_NAME>
				<TOOLTIP_TITLE>'WING SOURCE'</TOOLTIP_TITLE>
				<TOOLTIP_VAL_CODE>
					(L:P21_WING_SRC_KNOB) 0 == if{
						'FROM L'
					} els {
						(L:P21_WING_SRC_KNOB) 1 == if{
							'NORM'
						} else {
							(L:P21_WING_SRC_KNOB) 2 == if{
								'FROM R'
							}
						}
					}
				</TOOLTIP_VAL_CODE>
				<ONCHANGE_CODE></ONCHANGE_CODE>
