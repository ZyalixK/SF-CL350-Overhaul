			<PartID>P21_WING_SRC_KNOB</PartID>
			<CameraTitle>Pedestal</CameraTitle>
			<UseTemplate Name="P21_ROTARY_3STATE">
				<AUDIO_POS_X>0.450</AUDIO_POS_X>
				<AUDIO_POS_Y>0.441</AUDIO_POS_Y>
				<AUDIO_POS_Z>0.924</AUDIO_POS_Z>
