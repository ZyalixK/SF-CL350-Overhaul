      <Condition>
        <And>
          <And>
            <Not>
              <Simvar name="L:DEICE_Pitot_2" unit="Bool"/>
            </Not>
            <And>
              <Simvar name="L:DEICE_Pitot_1" unit="Bool"/>
            </And>
          </And>
          <And>
            <Or>
              <And>
