		<Component ID="P21_GEN_AUTO_L" Node="ELECTRICAL_Switch_Alternator_1">
			<UseTemplate Name="ASOBO_GT_Update">
				<UPDATE_CODE>
					(A:TURB ENG N1:1, percent) 15 &gt;
					if{
						(L:P21_GEN_AUTO_L_DONE) 0 ==
						if{
							1 (&gt;L:P21_GEN_AUTO_L_DONE)
							(A:GENERAL ENG MASTER ALTERNATOR:1, Bool) !
							if{ 1 (&gt;K:TOGGLE_MASTER_ALTERNATOR) }
						}
					} els{
						0 (&gt;L:P21_GEN_AUTO_L_DONE)
					}
				</UPDATE_CODE>
			</UseTemplate>
		</Component>

		<Component ID="P21_GEN_AUTO_R" Node="ELECTRICAL_Switch_Alternator_2">
			<UseTemplate Name="ASOBO_GT_Update">
				<UPDATE_CODE>
					(A:TURB ENG N1:2, percent) 15 &gt;
					if{
						(L:P21_GEN_AUTO_R_DONE) 0 ==
						if{
							1 (&gt;L:P21_GEN_AUTO_R_DONE)
							(A:GENERAL ENG MASTER ALTERNATOR:2, Bool) !
							if{ 2 (&gt;K:TOGGLE_MASTER_ALTERNATOR) }
						}
					} els{
						0 (&gt;L:P21_GEN_AUTO_R_DONE)
					}
				</UPDATE_CODE>
			</UseTemplate>
		</Component>

	</Template>

