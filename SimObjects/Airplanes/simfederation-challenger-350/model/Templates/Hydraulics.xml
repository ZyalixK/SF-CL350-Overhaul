    <!-- L_PUMP_KNOB -->
    <Component ID="P21_HYD_L_PUMP_KNOB" Node="ASOBO_ENGINE_Switch_Hydraulic_1">
      <PartID>P21_HYD_L_PUMP_KNOB</PartID>
      <CameraTitle>Pedestal</CameraTitle>
      <UseTemplate Name="P21_ROTARY_3STATE">
        <AUDIO_POS_X>0.450</AUDIO_POS_X>
        <AUDIO_POS_Y>0.441</AUDIO_POS_Y>
        <AUDIO_POS_Z>0.924</AUDIO_POS_Z>
        <NODE_ID>ASOBO_ENGINE_Switch_Hydraulic_1</NODE_ID>
        <ANIM_NAME>ASOBO_ENGINE_Switch_Hydraulic_1</ANIM_NAME>
        <VAR_NAME>L:P21_HYD_L_PUMP_KNOB</VAR_NAME>
        <TOOLTIP_TITLE>'LEFT PUMP KNOB'</TOOLTIP_TITLE>
        <TOOLTIP_VAL_CODE>
					(L:P21_HYD_L_PUMP_KNOB) 0 == if{
						'Off'
					}
					(L:P21_HYD_L_PUMP_KNOB) 1 == if{
						'Auto'
					}
					(L:P21_HYD_L_PUMP_KNOB) 2 == if{
						'On'
					}
        </TOOLTIP_VAL_CODE>
        <ONCHANGE_CODE></ONCHANGE_CODE>
        <ONUPDATE_CODE>
          (L:P21_HYD_L_PUMP_KNOB) 0 == if{
						(L:P21_HYD_R_PUMP_KNOB) 0 == if{
							1 (A:HYDRAULIC SWITCH:3,Number) == if{
								3 (&gt;K:HYDRAULIC_SWITCH_TOGGLE)
							}
						}

						(L:P21_HYD_L_PUMP_KNOB) 0 == if{
							(A:FUELSYSTEM TRIGGER STATUS:1,number) 1 == if{
								1 (&gt;L:P21_HYD_L_PUMP_KNOB)
							}
						}
					}
					els{
						0 (A:HYDRAULIC SWITCH:3,Number) == if{
							3 (&gt;K:HYDRAULIC_SWITCH_TOGGLE)
						}
					}
        </ONUPDATE_CODE>
      </UseTemplate>
    </Component>

