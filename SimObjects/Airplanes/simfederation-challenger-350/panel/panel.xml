    <Annunciation>
      <Type>Advisory</Type>
      <Text>FUEL BOOST ON L-R</Text>
      <Condition>
        <Or>
          <And>
            <Simvar name="GENERAL ENG FUEL PUMP ON:1" unit="Bool"/>
            <Simvar name="GENERAL ENG FUEL PUMP ON:2" unit="Bool"/>
          </And>
          <And>
            <Simvar name="GENERAL ENG FUEL PUMP ON:1" unit="Bool"/>
            <Simvar name="FUEL TRANSFER PUMP ON:2" unit="Bool"/>
          </And>
          <And>
            <Simvar name="GENERAL ENG FUEL PUMP ON:2" unit="Bool"/>
            <Simvar name="FUEL TRANSFER PUMP ON:1" unit="Bool"/>
          </And>
        </Or>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Advisory</Type>
      <Text>FUEL BOOST ON L</Text>
      <Condition>
        <Or>
          <And>
            <Not>
              <Simvar name="GENERAL ENG FUEL PUMP ON:2" unit="Bool"/>
            </Not>
            <And>
              <Simvar name="GENERAL ENG FUEL PUMP ON:1" unit="Bool"/>
            </And>
          </And>
          <And>
            <Not>
              <Simvar name="FUEL TRANSFER PUMP ON:2" unit="Bool"/>
            </Not>
            <And>
              <Simvar name="FUEL TRANSFER PUMP ON:1" unit="Bool"/>
            </And>
          </And>
          <Or>
            <And>
              <And>
                <Simvar name="GENERAL ENG STARTER ACTIVE:1" unit="Bool"/>
              </And>
              <And>
                <And>
                  <Greater>
                    <Simvar name="TURB ENG N2:1" unit="percent"/>
                    <Constant>1</Constant>
                  </Greater>
                </And>
                <And>
                  <Lower>
                    <Simvar name="TURB ENG N2:1" unit="percent"/>
                    <Constant>45</Constant>
