				<TOOLTIP_TITLE>'AIRFRAME DE-ICE'</TOOLTIP_TITLE>
      				<TT_DESCRIPTION>'SET AIRFRAME DE-ICE POSITION'</TT_DESCRIPTION>
				<TOOLTIP_VAL_CODE>
					(L:P21_WING_PUSH_BTN) 0 == if{
