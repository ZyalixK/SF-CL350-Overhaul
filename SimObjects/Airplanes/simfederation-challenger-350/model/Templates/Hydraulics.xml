<ModelBehaviors>
  <Template Name="P21_HYDRAULICS_TEMPLATE">
    <!-- L_SOV -->
    <Component ID="P21_L_SOV_BTN" Node="Hydraulic_SOV_1">
      <UseTemplate Name="P21_BTN_PUSH_TOGGLE">
        <AUDIO_POS_X>0.479</AUDIO_POS_X>
        <AUDIO_POS_Y>0.731</AUDIO_POS_Y>
        <AUDIO_POS_Z>0.621</AUDIO_POS_Z>
        <NODE_ID>Hydraulic_SOV_1</NODE_ID>
        <ANIM_NAME>Hydraulic_SOV_1</ANIM_NAME>
        <VAR_NAME>L:P21_HYD_L_SOV_BTN</VAR_NAME>
        <TOOLTIPID>L:P21_HYD_L_SOV_BTN</TOOLTIPID>
        <TOOLTIP_TITLE>'LEFT HYDRAULIC SOV'</TOOLTIP_TITLE>
        <TOOLTIP_VAL_CODE>
					(L:P21_HYD_L_SOV_BTN) 0 == if{
							'Closed'
					} els{
							'Open'
					}
        </TOOLTIP_VAL_CODE>
        <ONUPDATE_CODE>
          (L:P21_HYD_L_SOV_BTN) 1 == if{						
            (A:FUELSYSTEM TRIGGER STATUS:1,number) 1 == if{
              0 (&gt;L:P21_HYD_L_SOV_BTN)
            }
          }
        </ONUPDATE_CODE>
      </UseTemplate>
    </Component>

