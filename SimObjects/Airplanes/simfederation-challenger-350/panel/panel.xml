      <Condition>
        <Or>
          <And>
            <Not>
              <Simvar name="GENERAL ENG FUEL PUMP ON:1" unit="Bool"/>
            </Not>
            <And>
              <Simvar name="GENERAL ENG FUEL PUMP ON:2" unit="Bool"/>
            </And>
          </And>
          <And>
            <Not>
              <Simvar name="FUEL TRANSFER PUMP ON:1" unit="Bool"/>
            </Not>
            <And>
              <Simvar name="FUEL TRANSFER PUMP ON:2" unit="Bool"/>
            </And>
          </And>
          <Or>
            <And>
              <And>
                <Simvar name="GENERAL ENG STARTER ACTIVE:2" unit="Bool"/>
              </And>
              <And>
                <And>
                  <Greater>
                    <Simvar name="TURB ENG N2:2" unit="percent"/>
                    <Constant>1</Constant>
                  </Greater>
                </And>
                <And>
                  <Lower>
                    <Simvar name="TURB ENG N2:2" unit="percent"/>
                    <Constant>45</Constant>
                  </Lower>
                </And>
              </And>
            </And>
          </Or>
        </Or>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Advisory</Type>
      <Text>FUEL TRANSFER</Text>
      <Condition>
        <And>
          <Not>
            <Inequal tolerance="8.95">
              <Simvar name="FUEL TANK LEFT MAIN QUANTITY" unit="gallon"/>
              <Simvar name="FUEL TANK RIGHT MAIN QUANTITY" unit="gallon"/>
            </Inequal>
          </Not>
          <And>
            <Simvar name="FUEL TRANSFER PUMP ON" unit="Bool"/>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Advisory</Type>
      <Text>DATALINK MESSAGE</Text>
      <Condition>
        <Equal>
          <Simvar name="L:WT_CMU_DATALINK_RCVD" unit="number"/>
          <Constant>1</Constant>
        </Equal>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Advisory</Type>
      <Text>NO TAKEOFF</Text>
      <Condition>
        <And>
          <And>
            <Simvar name="SIM ON GROUND" unit="bool"/>
          </And>
          <Lower>
            <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:1" unit="percent"/>
            <Constant>70</Constant>
          </Lower>
          <Lower>
            <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:2" unit="percent"/>
            <Constant>70</Constant>
          </Lower>
          <Or>
            <Greater>
              <Simvar name="TRAILING EDGE FLAPS LEFT ANGLE" unit="Degree"/>
              <Constant>16</Constant>
            </Greater>
            <Greater>
              <Simvar name="SPOILERS HANDLE POSITION" unit="Percent"/>
              <Constant>0.1</Constant>
            </Greater>
            <Greater>
              <Simvar name="ELEVATOR TRIM PCT" unit="Percent"/>
              <Constant>27</Constant>
            </Greater>
            <Lower>
              <Simvar name="ELEVATOR TRIM PCT" unit="Percent"/>
              <Constant>-40</Constant>
            </Lower>
          </Or>
        </And>
      </Condition>
    </Annunciation>

  </Annunciations>

  <!-- Voices Alerts -->

  <VoicesAlerts>

    <Alert>
      <Type>SoundOnly</Type>
      <SoundEvent>aural_500ft</SoundEvent>
      <Condition>
        <StateMachine>
          <State id="Under" value="0">
            <Transition to="Over">
              <GreaterEqual>
                <Simvar name="PLANE ALT ABOVE GROUND MINUS CG" unit="feet"/>
                <Constant>510</Constant>
              </GreaterEqual>
            </Transition>
          </State>
          <State id="Over" value="0">
            <Transition to="Alerting">
              <LowerEqual>
                <Simvar name="PLANE ALT ABOVE GROUND MINUS CG" unit="feet"/>
                <Constant>500</Constant>
              </LowerEqual>
            </Transition>
          </State>
          <State id="Alerting" value="1">
            <Transition to="Under">
              <Constant>1</Constant>
            </Transition>
          </State>
        </StateMachine>
      </Condition>
    </Alert>

    <Alert>
      <Type>SoundOnly</Type>
      <SoundEvent>aural_stall</SoundEvent>
      <Condition>
        <Simvar name="L:WT21_STALL_WARNING" unit="number"/>
      </Condition>
    </Alert>

    <Alert>
      <Type>Warning</Type>
      <ShortText>PULL UP</ShortText>
      <LongText>PULL UP</LongText>
      <SoundEvent>aural_pull_up</SoundEvent>
      <Condition>
        <And>
          <LinearMultiPoint>
            <Table>
              <ReferencePoints>1160,2320,4930,12000</ReferencePoints>
              <Maximums>0,1070,2380,4285</Maximums>
            </Table>
            <Param>
              <Multiply>
                <Simvar name="VERTICAL SPEED" unit="feet per minute"/>
                <Constant>-1</Constant>
              </Multiply>
            </Param>
            <Param>
              <Simvar name="PLANE ALT ABOVE GROUND" unit="feet"/>
            </Param>
          </LinearMultiPoint>
          <Not>
            <Simvar name="SIM ON GROUND" unit="bool"/>
          </Not>
        </And>
      </Condition>
    </Alert>

    <Alert>
      <Type>SoundOnly</Type>
      <SoundEvent>aural_overspeed</SoundEvent>
      <Condition>
        <Simvar name="OVERSPEED WARNING" unit="bool"/>
      </Condition>
    </Alert>

    <Alert>
      <Type>Caution</Type>
      <ShortText>TERRAIN</ShortText>
      <LongText>SINK RATE</LongText>
      <SoundEvent>aural_sink_rate</SoundEvent>
      <Condition>
        <And>
          <LinearMultiPoint>
            <Table>
              <ReferencePoints>1160,2320,4930,12000</ReferencePoints>
              <Minimums>0,1070,2380,4285</Minimums>
              <Maximums>0,1460,2980,5360</Maximums>
            </Table>
            <Param>
              <Multiply>
                <Simvar name="VERTICAL SPEED" unit="feet per minute"/>
                <Constant>-1</Constant>
              </Multiply>
            </Param>
            <Param>
              <Simvar name="PLANE ALT ABOVE GROUND" unit="feet"/>
            </Param>
          </LinearMultiPoint>
          <Not>
            <Simvar name="SIM ON GROUND" unit="bool"/>
          </Not>
        </And>
      </Condition>
    </Alert>

    <Alert>
      <Type>Caution</Type>
      <ShortText>TERRAIN</ShortText>
      <LongText>DONT' SINK</LongText>
      <SoundEvent>aural_dont_sink</SoundEvent>
      <Condition>
        <And>
          <Lower>
            <DistanceFromOrigin/>
            <Constant>5</Constant>
          </Lower>
          <Lower>
            <HeadingChangeFromDeparture/>
            <Constant>110</Constant>
          </Lower>
          <Or>
            <LinearMultiPoint>
              <Table>
                <ReferencePoints>0,500,7000</ReferencePoints>
                <Maximums>50,700,700</Maximums>
                <Minimums>50,50,50</Minimums>
              </Table>
              <Param>
                <Multiply>
                  <Simvar name="VERTICAL SPEED" unit="feet per minute"/>
                  <Constant>-1</Constant>
                </Multiply>
              </Param>
              <Param>
                <Simvar name="PLANE ALT ABOVE GROUND" unit="feet"/>
              </Param>
            </LinearMultiPoint>
            <LinearMultiPoint>
              <Table>
                <ReferencePoints>10,70,150</ReferencePoints>
                <Maximums>50,700,700</Maximums>
                <Minimums>50,50,50</Minimums>
              </Table>
              <Param>
                <Substract>
                  <MaxSinceStart>
                    <ResetCondition>
                      <Simvar name="SIM ON GROUND" unit="bool"/>
                    </ResetCondition>
                    <Simvar name="PLANE ALTITUDE" unit="feet"/>
                  </MaxSinceStart>
                  <Simvar name="PLANE ALTITUDE" unit="feet"/>
                </Substract>
              </Param>
              <Param>
                <Simvar name="PLANE ALT ABOVE GROUND" unit="feet"/>
              </Param>
            </LinearMultiPoint>
          </Or>
        </And>
      </Condition>
    </Alert>

    <Alert>
      <Type>SoundOnly</Type>
      <SoundEvent>aural_landing_gear</SoundEvent>
      <Condition>
        <And>
          <Or>            <!-- One of the following conditions is true: -->
            <And>              <!-- a) both engines working, both throttles lower than CRU -->
              <Not>
                <Simvar name="GENERAL ENG FAILED:1" unit="Boolean"/>
                <Simvar name="GENERAL ENG FAILED:2" unit="Boolean"/>
              </Not>
              <Lower>
                <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:1" unit="percent"/>
                <Constant>70</Constant>
              </Lower>
              <Lower>
                <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:2" unit="percent"/>
                <Constant>70</Constant>
              </Lower>
            </And>
            <And>              <!-- b) engine 1 failed, not set to STOP, and engine 2 throttle lower than CRU -->
              <Simvar name="GENERAL ENG FAILED:1" unit="Boolean"/>
              <Simvar name="GENERAL ENG FUEL VALVE:1" unit="Boolean"/>
              <Lower>
                <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:2" unit="percent"/>
                <Constant>70</Constant>
              </Lower>
            </And>
            <And>              <!-- c) engine 2 failed, not set to STOP, and engine 1 throttle lower than CRU -->
              <Simvar name="GENERAL ENG FAILED:2" unit="Boolean"/>
              <Simvar name="GENERAL ENG FUEL VALVE:2" unit="Boolean"/>
              <Lower>
                <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:1" unit="percent"/>
                <Constant>70</Constant>
              </Lower>
            </And>
          </Or>
          <!-- Gear can be retracted and isn't down -->
          <Simvar name="IS GEAR RETRACTABLE" unit="Boolean"/>
          <Not>
            <Simvar name="GEAR HANDLE POSITION" unit="Boolean"/>
          </Not>
          <Or>            <!-- One of the following conditions is true: -->
            <Equal>              <!-- a) Flaps greater than 15-degrees -->
              <Simvar name="FLAPS HANDLE INDEX" unit="number"/>
              <Constant>2</Constant>
            </Equal>
            <And>              <!-- b) flaps less than/equal to 15-degrees and RADALT lower than 500 ft -->
              <Lower>
                <Simvar name="FLAPS HANDLE INDEX" unit="number"/>
                <Constant>2</Constant>
              </Lower>
              <Lower>
                <Simvar name="RADIO HEIGHT" unit="feet"/>
                <Constant>500</Constant>
              </Lower>
            </And>
          </Or>
        </And>
      </Condition>
    </Alert>

