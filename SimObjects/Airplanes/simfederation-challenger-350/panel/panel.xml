<PlaneHTMLConfig>
  <AOASystem>
    <Flaps index="1" zeroLift="-6.5" stall="10.25" correctionFactor="1" />
    <Flaps index="2" zeroLift="-8" stall="10.25" correctionFactor="1" />
  </AOASystem>
  <Instrument>
    <Name>HourMeter</Name>
    <Electric>
      <Simvar name="CIRCUIT GENERAL PANEL ON" unit="Boolean"/>
    </Electric>
  </Instrument>
  <Instrument>
    <Name>WT21_PFD</Name>
    <RadarAltitude>True</RadarAltitude>
    <Electric>
      <Or>
        <Simvar name="CIRCUIT ON:40" unit="Boolean"/>
      </Or>
    </Electric>

    <VNAV advanced="True">
      <FmsSpeeds>
        <GeneralLimits>
          <Mach>
            <Minimum>0.2</Minimum>
            <Maximum>0.83</Maximum>
          </Mach>
        </GeneralLimits>
      </FmsSpeeds>
    </VNAV>
  </Instrument>
  <Instrument>
    <Name>WT21_MFD_1</Name>
    <Electric>
      <Or>
        <Simvar name="CIRCUIT ON:41" unit="Boolean"/>
      </Or>
    </Electric>
  </Instrument>
  <Instrument>
    <Name>WT21_MFD_2</Name>
    <Electric>
      <Or>
        <Simvar name="CIRCUIT ON:41" unit="Boolean"/>
      </Or>
    </Electric>
  </Instrument>
  <Instrument>
    <Name>CJ4_SAI</Name>
    <Electric>
      <Simvar name="CIRCUIT ON:48" unit="Boolean"/>
    </Electric>
  </Instrument>
  <Instrument>
    <Name>A320_Neo_Clock</Name>
    <Electric>
      <Simvar name="CIRCUIT ON:50" unit="Boolean"/>
    </Electric>
  </Instrument>
  <Instrument>
    <Name>WT21_FMC_1</Name>
    <Electric>
      <Or>
        <Simvar name="CIRCUIT ON:49" unit="Boolean"/>
      </Or>
    </Electric>
    <AlwaysUpdate>True</AlwaysUpdate>

    <VNAV advanced="True">
      <FmsSpeeds>
        <GeneralLimits>
          <Mach>
            <Minimum>0.2</Minimum>
            <Maximum>0.83</Maximum>
          </Mach>
        </GeneralLimits>
      </FmsSpeeds>
    </VNAV>
  </Instrument>
  <Instrument>
    <Name>WT21_FMC_2</Name>
    <Electric>
      <Or>
        <Simvar name="CIRCUIT ON:51" unit="Boolean"/>
      </Or>
    </Electric>
    <AlwaysUpdate>True</AlwaysUpdate>

    <VNAV advanced="True">
      <FmsSpeeds>
        <GeneralLimits>
          <Mach>
            <Minimum>0.2</Minimum>
            <Maximum>0.83</Maximum>
          </Mach>
        </GeneralLimits>
      </FmsSpeeds>
    </VNAV>
  </Instrument>

  <!-- Annunciations -->
  <Annunciations>

    <Annunciation>
      <Type>Warning</Type>
      <Text>OIL PRESSURE LOW L-R</Text>
      <Condition>
        <And>
          <And>
            <LowerEqual>
              <Simvar name="ENG OIL PRESSURE:2" unit="psi"/>
              <Constant>22</Constant>
            </LowerEqual>
          </And>
          <And>
            <LowerEqual>
              <Simvar name="ENG OIL PRESSURE:1" unit="psi"/>
              <Constant>22</Constant>
            </LowerEqual>
          </And>
          <And>
            <Greater>
              <Simvar name="TURB ENG N2:1" unit="percent"/>
              <Constant>50</Constant>
            </Greater>
          </And>
          <And>
            <Greater>
              <Simvar name="TURB ENG N2:2" unit="percent"/>
              <Constant>50</Constant>
            </Greater>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>OIL PRESSURE LOW L</Text>
      <Condition>
        <And>
          <Not>
            <LowerEqual>
              <Simvar name="ENG OIL PRESSURE:2" unit="psi"/>
              <Constant>22</Constant>
            </LowerEqual>
          </Not>
          <And>
            <LowerEqual>
              <Simvar name="ENG OIL PRESSURE:1" unit="psi"/>
              <Constant>22</Constant>
            </LowerEqual>
          </And>
          <And>
            <Greater>
              <Simvar name="TURB ENG N2:1" unit="percent"/>
              <Constant>50</Constant>
            </Greater>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>OIL PRESSURE LOW R</Text>
      <Condition>
        <And>
          <Not>
            <LowerEqual>
              <Simvar name="ENG OIL PRESSURE:1" unit="psi"/>
              <Constant>22</Constant>
            </LowerEqual>
          </Not>
          <And>
            <LowerEqual>
              <Simvar name="ENG OIL PRESSURE:2" unit="psi"/>
              <Constant>22</Constant>
            </LowerEqual>
          </And>
          <And>
            <Greater>
              <Simvar name="TURB ENG N2:2" unit="percent"/>
              <Constant>50</Constant>
            </Greater>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>CABIN ALTITUDE</Text>
      <Condition>
        <Greater>
          <Simvar name="PRESSURIZATION CABIN ALTITUDE" unit="feet"/>
          <Constant>9800</Constant>
        </Greater>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>DOOR</Text>
      <Condition>
        <Greater>
          <Simvar name="EXIT OPEN:0" unit="percent"/>
          <Constant>0</Constant>
        </Greater>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>ENGINE FIRE L</Text>
      <Condition>
        <And>
          <Not>
            <Simvar name="ENG ON FIRE:2" unit="Bool"/>
          </Not>
          <And>
            <Simvar name="ENG ON FIRE:1" unit="Bool"/>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>ENGINE FIRE R</Text>
      <Condition>
        <And>
          <Not>
            <Simvar name="ENG ON FIRE:1" unit="Bool"/>
          </Not>
          <And>
            <Simvar name="ENG ON FIRE:2" unit="Bool"/>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>DC GENERATOR OFF L-R</Text>
      <Condition>
        <And>
          <Not>
            <Or>
              <Simvar name="GENERAL ENG MASTER ALTERNATOR:1" unit="Bool"/>
              <Simvar name="GENERAL ENG MASTER ALTERNATOR:2" unit="Bool"/>
            </Or>
          </Not>
          <And>
            <Not>
              <Simvar name="SIM ON GROUND" unit="bool"/>
            </Not>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>DC GENERATOR OFF L</Text>
      <Condition>
        <And>
          <Not>
            <Simvar name="GENERAL ENG MASTER ALTERNATOR:1" unit="Bool"/>
          </Not>
          <And>
            <Simvar name="GENERAL ENG MASTER ALTERNATOR:2" unit="Bool"/>
          </And>
          <And>
            <Not>
              <Simvar name="SIM ON GROUND" unit="bool"/>
            </Not>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>DC GENERATOR OFF R</Text>
      <Condition>
        <And>
          <Not>
            <Simvar name="GENERAL ENG MASTER ALTERNATOR:2" unit="Bool"/>
          </Not>
          <And>
            <Simvar name="GENERAL ENG MASTER ALTERNATOR:1" unit="Bool"/>
          </And>
          <And>
            <Not>
              <Simvar name="SIM ON GROUND" unit="bool"/>
            </Not>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Warning</Type>
      <Text>NO TAKEOFF</Text>
      <Condition>
        <And>
          <And>
            <Simvar name="SIM ON GROUND" unit="bool"/>
          </And>
          <Greater>
            <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:1" unit="percent"/>
            <Constant>70</Constant>
          </Greater>
          <Greater>
            <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:2" unit="percent"/>
            <Constant>70</Constant>
          </Greater>
          <Or>
            <Greater>
              <Simvar name="TRAILING EDGE FLAPS LEFT ANGLE" unit="Degree"/>
              <Constant>16</Constant>
            </Greater>
            <Greater>
              <Simvar name="SPOILERS HANDLE POSITION" unit="Percent"/>
              <Constant>0.1</Constant>
            </Greater>
            <Greater>
              <Simvar name="ELEVATOR TRIM PCT" unit="Percent"/>
              <Constant>49</Constant>
            </Greater>
            <Lower>
              <Simvar name="ELEVATOR TRIM PCT" unit="Percent"/>
              <Constant>-9</Constant>
            </Lower>
          </Or>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Caution</Type>
      <Text>EMER LIGHTS NOT ARMED</Text>
      <Condition>
        <Equal>
          <Simvar name="L:BC350_EMER_LIGHT_ARMED" unit="number"/>
          <Constant>0</Constant>
        </Equal>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Caution</Type>
      <Text>PRESSURE SOURCE NOT NORM</Text>
      <Condition>
        <And>
          <Inequal>
            <Simvar name="L:WT_CJ4_PRESS_SOURCE" unit="number"/>
            <Constant>2</Constant>
          </Inequal>
          <Simvar name="SIM ON GROUND" unit="bool"/>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Caution</Type>
      <Text>PARKING BRAKE</Text>
      <Condition>
        <And>
          <Greater>
            <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:1" unit="percent"/>
            <Constant>70</Constant>
          </Greater>
          <Greater>
            <Simvar name="GENERAL ENG THROTTLE LEVER POSITION:2" unit="percent"/>
            <Constant>70</Constant>
          </Greater>
          <And>
            <Simvar name="BRAKE PARKING INDICATOR" unit="Bool"/>
          </And>
        </And>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Caution</Type>
      <Text>FUEL TRANSFER</Text>
      <Condition>
        <Or>
          <And>
            <Inequal tolerance="8.95">
              <Simvar name="FUEL TANK LEFT MAIN QUANTITY" unit="gallon"/>
              <Simvar name="FUEL TANK RIGHT MAIN QUANTITY" unit="gallon"/>
            </Inequal>
            <And>
              <Simvar name="FUEL TRANSFER PUMP ON" unit="Bool"/>
            </And>
          </And>
          <And>
            <Not>
              <Simvar name="FUEL TRANSFER PUMP ON" unit="Bool"/>
            </Not>
            <Inequal tolerance="29.8">
              <Simvar name="FUEL TANK LEFT MAIN QUANTITY" unit="gallon"/>
              <Simvar name="FUEL TANK RIGHT MAIN QUANTITY" unit="gallon"/>
            </Inequal>
          </And>
        </Or>
      </Condition>
    </Annunciation>

    <Annunciation>
      <Type>Caution</Type>
      <Text>FUEL LEVEL LOW L-R</Text>
      <Condition>
        <And>
          <And>
            <LowerEqual>
              <Simvar name="FUEL TANK LEFT MAIN QUANTITY" unit="gallon"/>
              <Constant>29.8</Constant>
            </LowerEqual>
          </And>
          <And>
            <LowerEqual>
              <Simvar name="FUEL TANK RIGHT MAIN QUANTITY" unit="gallon"/>
              <Constant>29.8</Constant>
            </LowerEqual>
          </And>
        </And>
      </Condition>
    </Annunciation>

