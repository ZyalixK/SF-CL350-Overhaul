		<!-- STBY -->
		<Component ID="P21_EL_STBY" Node="ELECTRICAL_Switch_Battery_STBY_1">
			<UseTemplate Name="P21_BTN_PUSH_TOGGLE">
				<NODE_ID>ELECTRICAL_Switch_Battery_STBY_1</NODE_ID>
				<ANIM_NAME>ELECTRICAL_Switch_Battery_STBY_1</ANIM_NAME>
				<VAR_NAME>L:P21_X_STBY_BATT</VAR_NAME>
				<TOOLTIP_TITLE>'STANDBY BATTERY'</TOOLTIP_TITLE>
      			<TT_DESCRIPTION>'SET STANDBY BATTERY POSITION'</TT_DESCRIPTION>
				<TOOLTIP_VAL_CODE>
					(L:P21_X_STBY_BATT) 0 == if{
							'Disabled'
					} els{
							'Enabled'
					}
				</TOOLTIP_VAL_CODE>

				<ONCHANGE_CODE>
					(L:P21_X_STBY_BATT) 100 * (&gt;O:ANIM_TARGET_POS)
					(L:P21_X_STBY_BATT) 0 == if{
						0 (&gt;K:BATTERY3_SET)
						0 (&gt;O:_LAST_VALUE)
					} els{
						1 (&gt;K:BATTERY3_SET)
						1 (&gt;O:_LAST_VALUE)
					}
				</ONCHANGE_CODE>

				<ONUPDATE_CODE>
					(L:P21_X_STBY_BATT) 100 * (&gt;O:ANIM_TARGET_POS)
					(O:_LAST_VALUE) (L:P21_X_STBY_BATT) != if{
							(L:P21_X_STBY_BATT) (&gt;K:BATTERY3_SET)
							(L:P21_X_STBY_BATT) (&gt;O:_LAST_VALUE)
					}

				</ONUPDATE_CODE>
			</UseTemplate>
		</Component>

