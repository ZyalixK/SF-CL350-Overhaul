		<!-- AIR SOURCE SELECTION -->
		<Component ID="AIR_SOURCE_SELECTION_1" Node="Air_Source_Knob">
			<PartID>CL_Dashboard_055</PartID>
			<CameraTitle>Pilot</CameraTitle>
			<UseTemplate Name="P21_ROTARY_4STATE">
				<AUDIO_POS_X>0.263</AUDIO_POS_X>
				<AUDIO_POS_Y>0.776</AUDIO_POS_Y>
				<AUDIO_POS_Z>0.348</AUDIO_POS_Z>
				<NODE_ID>Air_Source_Knob</NODE_ID>
				<ANIM_NAME>Air_Source_Knob</ANIM_NAME>
				<VAR_NAME>L:P21_AIR_SOURCE_KNOB</VAR_NAME>
				<TOOLTIP_VAL_CODE>
					(L:P21_AIR_SOURCE_KNOB) 0 == if{
							'OFF'
					} 
					(L:P21_AIR_SOURCE_KNOB) 1 == if{
							'NORM'
					}
					(L:P21_AIR_SOURCE_KNOB) 2 == if{
							'PACK ONLY'
					}
					(L:P21_AIR_SOURCE_KNOB) 3 == if{
							'TRIM AIR ONLY'
					}
					(L:P21_AIR_SOURCE_KNOB) 4 == if{
							'UNUSED'
					}
				</TOOLTIP_VAL_CODE>
				<TOOLTIP_TITLE>'AIR SOURCE'</TOOLTIP_TITLE>
			</UseTemplate>
		</Component>

